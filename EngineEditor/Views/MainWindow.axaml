<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:EngineEditor.Converters"
        x:Class="EngineEditor.Views.MainWindow"
        x:CompileBindings="False"
        Title="Визуальный Конструктор Новелл v0.6 - Drag &amp; Drop Edition"
        Width="1550" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D12">

    <Window.Resources>
        <conv:NodeTypeEqualsConverter x:Key="NodeTypeEquals"/>
        <conv:NodeTypeNotEqualsConverter x:Key="NodeTypeNotEquals"/>
    </Window.Resources>


    <Grid ColumnDefinitions="260, *, 280, 320">

        <!-- КОЛОНКА 1: СПИСОК СЦЕН И ПАЛИТРА -->
        <Border Grid.Column="0" Background="#161620" Padding="10" BorderBrush="#2A2A35" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, Auto, *, Auto, Auto">
                <TextBlock Grid.Row="0" Text="[ СТРУКТУРА ПРОЕКТА ]" Foreground="#00FF66" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                <Grid Grid.Row="1" ColumnDefinitions="*, 5, *" Margin="0,0,0,10">
                    <Button Grid.Column="0" Content="💾 Сохранить" Click="OnSaveProjectClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#007acc" Foreground="White" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="📂 Открыть" Click="OnLoadProjectClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#2A2A35" Foreground="White" Cursor="Hand"/>
                </Grid>

                <ListBox Grid.Row="2" x:Name="ScenesListBox"
                         Background="#0D0D12" Foreground="White"
                         SelectionChanged="OnSceneSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Padding="5" FontFamily="Consolas"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- НОВОЕ: ПАЛИТРА НОДОВ ДЛЯ DRAG & DROP -->
                <TextBlock Grid.Row="3" Text="[ ПАЛИТРА УЗЛОВ ]" Foreground="#00FF66" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,15,0,10" HorizontalAlignment="Center"/>

                <StackPanel Grid.Row="4" Spacing="8">
                    <!-- Узел Диалога -->
                    <Border Background="#1A1A24" BorderBrush="#007acc" BorderThickness="1" CornerRadius="4" Padding="8" Cursor="Hand" PointerPressed="OnPaletteItemPointerPressed" Tag="Dialogue">
                        <TextBlock Text="🗨 Сцена (Диалог)" Foreground="White" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- Узел Выбора -->
                    <Border Background="#1A1A24" BorderBrush="#ffc107" BorderThickness="1" CornerRadius="4" Padding="8" Cursor="Hand" PointerPressed="OnPaletteItemPointerPressed" Tag="Choice">
                        <TextBlock Text="⩔ Узел выбора" Foreground="White" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- Узел Действия -->
                    <Border Background="#1A1A24" BorderBrush="#e83e8c" BorderThickness="1" CornerRadius="4" Padding="8" Cursor="Hand" PointerPressed="OnPaletteItemPointerPressed" Tag="Action">
                        <TextBlock Text="⚙ Системное действие" Foreground="White" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- Узел Условия -->
                    <Border Background="#1A1A24" BorderBrush="#17a2b8" BorderThickness="1" CornerRadius="4" Padding="8" Cursor="Hand" PointerPressed="OnPaletteItemPointerPressed" Tag="Condition">
                        <TextBlock Text="❓ Условие (Ветвление)" Foreground="White" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- Кнопка удаления -->
                    <Button Content="❌ Удалить выбранный узел" Click="OnDeleteSceneClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#dc3545" Foreground="White" Cursor="Hand" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- КОЛОНКА 2: ДИНАМИЧЕСКИЙ НОДОВЫЙ ГРАФ -->
        <Border Grid.Column="1" Background="#0D0D12" ClipToBounds="True" PointerWheelChanged="OnCanvasPointerWheelChanged">

            <!-- ИСПРАВЛЕНО: Добавлен ClipToBounds="False" -->
            <Canvas x:Name="GraphCanvas" Background="Transparent" ClipToBounds="False">

                <Path x:Name="ConnectionLine" Stroke="#00FF66" StrokeThickness="3" StrokeDashArray="4,2"/>
                <Path x:Name="TempLinkLine" Stroke="#FFA500" StrokeThickness="2" StrokeDashArray="4,3"/>

                <!-- ИСПРАВЛЕНО: Убраны Width и Height. Добавлен прозрачный шаблон ItemsPresenter -->
                <ItemsControl x:Name="NodesItemsControl" ItemsSource="{Binding Scenes}" ClipToBounds="False">

                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" ClipToBounds="False"/>
                        </ControlTemplate>
                    </ItemsControl.Template>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="Transparent" ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.Styles>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Width="240"
                                        Background="#2d2d2d"
                                        BorderBrush="#444"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        PointerPressed="OnNodePointerPressed">

                                    <StackPanel Margin="10">
                                        <!-- Шапка нода -->
                                        <Border Background="{Binding HeaderColor}" CornerRadius="4" Padding="6" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <!-- Текст нода -->
                                        <TextBlock Text="{Binding Text}" Foreground="#ccc" TextWrapping="Wrap"/>
                                    </StackPanel>

                                </Border>

                                <!-- Коннектор для ручного соединения -->
                                <Ellipse Width="16" Height="16" Fill="#00FF66" Stroke="White" StrokeThickness="1.5"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-8,0"
                                         Cursor="Hand" PointerPressed="OnConnectorPointerPressed"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Border>

        <!-- КОЛОНКА 3: УПРАВЛЕНИЕ ДВИЖКОМ -->
        <Border Grid.Column="2" Background="#161620" Padding="15" BorderBrush="#2A2A35" BorderThickness="1,0,0,0">
            <StackPanel Spacing="15">
                <TextBlock Text="[ ENGINE KERNEL ]" Foreground="#00FF66" FontFamily="Consolas" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>

                <Button Content="▶ ЗАПУСТИТЬ ДВИЖОК" Click="OnStartEngineClick" HorizontalAlignment="Stretch" Height="45" Background="#28a745" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="■ Остановить" Click="OnStopEngineClick" HorizontalAlignment="Stretch" Background="#dc3545" Foreground="White" Cursor="Hand"/>

                <Separator Background="#2A2A35" Margin="0,10"/>

                <TextBlock Text="НАСТРОЙКИ ТЕКСТА" Foreground="White" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="Размер:" Foreground="#aaa" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="FontSizeTxt" Text="20px" Foreground="#007acc" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                </Grid>
                <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="36" Value="20" ValueChanged="OnFontSizeChanged"/>

                <Separator Background="#2A2A35" Margin="0,10"/>

                <TextBlock Text="АУДИО СИСТЕМА" Foreground="White" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="Громкость:" Foreground="#aaa" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="VolumeTxt" Text="100%" Foreground="#17a2b8" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Consolas"/>
                </Grid>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="OnVolumeChanged"/>

                <Button Content="⏳ Fade-out (2 сек)" Click="OnFadeOutClick" HorizontalAlignment="Stretch" Background="#6f42c1" Foreground="White" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- КОЛОНКА 4: ИНСПЕКТОР ВЫБРАННОГО НОДА -->
        <Border Grid.Column="3" Background="#161620" Padding="15" BorderBrush="#2A2A35" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Spacing="8" DataContext="{Binding SelectedItem, ElementName=ScenesListBox}">
                    <TextBlock Text="[ ИНСПЕКТОР НОДА ]" Foreground="#00FF66" FontFamily="Consolas" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                    <TextBlock Text="{Binding NodeType}" Foreground="#666" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                    <TextBlock Text="Название" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay}" LostFocus="OnAnyFieldChanged"/>

                    <TextBlock Text="Имя персонажа" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding CharacterName, Mode=TwoWay}"/>

                    <TextBlock Text="Текст реплики" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>

                    <TextBlock Text="Цвет шапки (#hex)" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding HeaderColor, Mode=TwoWay}"/>

                    <TextBlock Text="Фон сцены (Background)" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding Background, Mode=TwoWay}"/>

                    <TextBlock Text="Спрайт персонажа" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding CharacterSprite, Mode=TwoWay}"/>
                    <TextBlock Text="Анимация персонажа" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding CharacterAnimation, Mode=TwoWay}" Watermark="None / FadeIn / SlideLeft" LostFocus="OnAnyFieldChanged"/>

                    <Grid ColumnDefinitions="*, 8, *">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="X персонажа" Foreground="#aaa" FontSize="11"/>
                            <TextBox Text="{Binding CharacterX, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Y персонажа" Foreground="#aaa" FontSize="11"/>
                            <TextBox Text="{Binding CharacterY, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Музыка" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding Music, Mode=TwoWay}"/>

                    <Separator Background="#2A2A35" Margin="0,8"/>
                    <!-- НОВОЕ: Настройки для узла "Условие" -->
                    <StackPanel Spacing="8" IsVisible="{Binding NodeType, Converter={StaticResource NodeTypeEquals}, ConverterParameter=Condition}">
                        <Separator Background="#2A2A35" Margin="0,4"/>
                        <TextBlock Text="ЛОГИКА ВЕТВЛЕНИЯ" Foreground="#17a2b8" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>

                        <TextBlock Text="Переменная | Оператор | Значение" Foreground="#aaa" FontSize="10"/>
                        <Grid ColumnDefinitions="*, 40, 60">
                            <TextBox Grid.Column="0" Text="{Binding ConditionVariable, Mode=TwoWay}" Watermark="Имя (Money)" LostFocus="OnAnyFieldChanged"/>
                            <TextBox Grid.Column="1" Text="{Binding ConditionOperator, Mode=TwoWay}" Watermark=">=" Margin="4,0" LostFocus="OnAnyFieldChanged"/>
                            <TextBox Grid.Column="2" Text="{Binding ConditionValue, Mode=TwoWay}" Watermark="100" LostFocus="OnAnyFieldChanged"/>
                        </Grid>

                        <TextBlock Text="Если ИСТИНА (True), идти в:" Foreground="#28a745" FontSize="11"/>
                        <TextBox Text="{Binding TargetSceneIfTrue, Mode=TwoWay}" Foreground="#28a745" LostFocus="OnAnyFieldChanged"/>

                        <TextBlock Text="Если ЛОЖЬ (False), идти в:" Foreground="#dc3545" FontSize="11"/>
                        <TextBox Text="{Binding TargetSceneIfFalse, Mode=TwoWay}" Foreground="#dc3545" LostFocus="OnAnyFieldChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding NodeType, Converter={StaticResource NodeTypeNotEquals}, ConverterParameter=Choice}">
                        <TextBlock Text="Прямой переход (Имя след. сцены)" Foreground="#aaa" FontSize="11"/>
                        <TextBlock Text="Задаётся протяжкой 🔗 с нода на нод, или вручную" Foreground="#666" FontSize="10" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding TargetSceneName, Mode=TwoWay}" Foreground="#00FF66" LostFocus="OnAnyFieldChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding NodeType, Converter={StaticResource NodeTypeEquals}, ConverterParameter=Action}">
                        <Separator Background="#2A2A35" Margin="0,4"/>
                        <TextBlock Text="СИСТЕМНАЯ КОМАНДА" Foreground="#e83e8c" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="PlaySound: файл.wav • StopMusic • Volume: 50 • FadeOut: 2 • FontSize: 24  •  SetVar: HP - 10&#x0a;Shake: 1.5 • Flash: #FFFFFF" Foreground="#666"  FontSize="10" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding SystemCommand, Mode=TwoWay}" Watermark="Например: PlaySound: click.wav" LostFocus="OnAnyFieldChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding NodeType, Converter={StaticResource NodeTypeEquals}, ConverterParameter=Choice}">
                        <Separator Background="#2A2A35" Margin="0,4"/>
                        <TextBlock Text="ВАРИАНТЫ ВЫБОРА" Foreground="#00FF66" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="Целевую сцену можно вписать вручную или перетащить 🔗 с нода на нод" Foreground="#666" FontSize="10" TextWrapping="Wrap"/>

                        <ItemsControl ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                                        <StackPanel Spacing="4">
                                            <TextBox Text="{Binding Text, Mode=TwoWay}" Watermark="Текст варианта" FontSize="12" LostFocus="OnAnyFieldChanged"/>
                                            <TextBox Text="{Binding TargetSceneName, Mode=TwoWay}" Watermark="Имя целевой сцены" FontSize="11" Foreground="#00FF66" LostFocus="OnAnyFieldChanged"/>
                                            <Button Content="✕ Удалить" Click="OnRemoveChoiceClick" Tag="{Binding}" HorizontalAlignment="Right" FontSize="10" Padding="8,3" Background="#dc3545" Foreground="White" Cursor="Hand"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="➕ Добавить вариант" Click="OnAddChoiceClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#007acc" Foreground="White" Cursor="Hand" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>