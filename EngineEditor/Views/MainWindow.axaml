<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:EngineEditor.Converters"
        x:Class="EngineEditor.Views.MainWindow"
        x:CompileBindings="False"
        Title="MyGameNovella — редактор новелл"
        Width="1600" Height="960" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17">

    <Window.Resources>
        <conv:NodeTypeEqualsConverter x:Key="NodeTypeEquals"/>
        <conv:NodeTypeNotEqualsConverter x:Key="NodeTypeNotEquals"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#202A3A"/>
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#2C3A50"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#101722"/>
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="Border.palette-item">
            <Setter Property="Background" Value="#192337"/>
        </Style>
        <Style Selector="Border.palette-item:pointerover">
            <Setter Property="Background" Value="#263247"/>
        </Style>
    </Window.Styles>


    <Grid RowDefinitions="58,*,5,190,28" ColumnDefinitions="242,5,*,5,360">
        <Border Grid.Row="0" Grid.ColumnSpan="5" Background="#111925" BorderBrush="#263244" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="MY GAME NOVELLA" Foreground="#F1F5FB" FontSize="16" FontWeight="Bold" LetterSpacing="1.2"/>
                    <TextBlock Text="STORY EDITOR" Foreground="#8190A6" FontSize="9" FontWeight="SemiBold" LetterSpacing="1.8"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="ProjectStatus" Text="Новый проект" Foreground="#93A4BA" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0"/>
                <Button Grid.Column="2" Content="Открыть" Click="OnLoadProjectClick" MinWidth="86"/>
                <Button Grid.Column="3" Content="Сохранить" Click="OnSaveProjectClick" MinWidth="92" Background="#293B60" BorderBrush="#435B91" FontWeight="SemiBold"/>
                <Button Grid.Column="4" Content="▶  Запуск" Click="OnStartEngineClick" MinWidth="100" Background="#5168D8" BorderBrush="#667CF0" Foreground="White" FontWeight="Bold"/>
                <Button Grid.Column="5" Content="■  Стоп" Click="OnStopEngineClick" MinWidth="78" Background="#39212B" BorderBrush="#744055" Foreground="#F1C5D3"/>
            </Grid>
        </Border>

        <!-- Hierarchy -->
        <Border Grid.Row="1" Grid.Column="0" Background="#111925" Padding="14" BorderBrush="#263244" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Text="HIERARCHY" Foreground="#AAB8CC" FontSize="11" FontWeight="Bold" LetterSpacing="1.4" Margin="2,4,0,2"/>

                <ListBox Grid.Row="1" x:Name="ScenesListBox"
                         Background="#0C121B" Foreground="#E8EDF7"
                         SelectionChanged="OnSceneSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{Binding HeaderColor}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" Padding="2,6" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Text="CREATE NODE" Foreground="#AAB8CC" FontSize="10" FontWeight="Bold" LetterSpacing="1.3" Margin="2,8,0,0"/>

                <StackPanel Grid.Row="3" Spacing="7">
                    <Border Classes="palette-item" BorderBrush="#6478E8" BorderThickness="1" CornerRadius="7" Padding="10" Cursor="Hand" PointerPressed="OnPaletteItemPointerPressed" Tag="Dialogue">
                        <TextBlock Text="＋  Диалог" Foreground="#E8EDF7" FontSize="12" FontWeight="Medium"/>
                    </Border>
                    <Border Classes="palette-item" BorderBrush="#D7A541" BorderThickness="1" CornerRadius="7" Padding="10" Cursor="Hand" PointerPressed="OnPaletteItemPointerPressed" Tag="Choice">
                        <TextBlock Text="＋  Выбор" Foreground="#E8EDF7" FontSize="12" FontWeight="Medium"/>
                    </Border>
                    <Border Classes="palette-item" BorderBrush="#CF6C9C" BorderThickness="1" CornerRadius="7" Padding="10" Cursor="Hand" PointerPressed="OnPaletteItemPointerPressed" Tag="Action">
                        <TextBlock Text="＋  Действие / Lua" Foreground="#E8EDF7" FontSize="12" FontWeight="Medium"/>
                    </Border>
                    <Border Classes="palette-item" BorderBrush="#4AA6B4" BorderThickness="1" CornerRadius="7" Padding="10" Cursor="Hand" PointerPressed="OnPaletteItemPointerPressed" Tag="Condition">
                        <TextBlock Text="＋  Условие" Foreground="#E8EDF7" FontSize="12" FontWeight="Medium"/>
                    </Border>
                    <Button Content="Удалить выбранный узел" Click="OnDeleteSceneClick" HorizontalAlignment="Stretch" Margin="0,4,0,0" Background="#39212B" BorderBrush="#744055" Foreground="#F1C5D3"/>
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" Background="#263244" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

        <!-- Story graph workspace -->
        <Border Grid.Row="1" Grid.Column="2" Background="#0D131D" ClipToBounds="True" PointerWheelChanged="OnCanvasPointerWheelChanged">

            <!-- ИСПРАВЛЕНО: Добавлен ClipToBounds="False" -->
            <Canvas x:Name="GraphCanvas" Background="#0D131D" ClipToBounds="False">

                <Path x:Name="ConnectionLine" Stroke="#7185F0" StrokeThickness="2" StrokeDashArray="5,3"/>
                <Path x:Name="TempLinkLine" Stroke="#E9B75D" StrokeThickness="2" StrokeDashArray="5,3"/>

                <!-- ИСПРАВЛЕНО: Убраны Width и Height. Добавлен прозрачный шаблон ItemsPresenter -->
                <ItemsControl x:Name="NodesItemsControl" ItemsSource="{Binding Scenes}" ClipToBounds="False">

                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" ClipToBounds="False"/>
                        </ControlTemplate>
                    </ItemsControl.Template>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="Transparent" ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.Styles>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Width="245"
                                        Background="#1A2433"
                                        BorderBrush="#334258"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        PointerPressed="OnNodePointerPressed">

                                    <StackPanel Margin="11">
                                        <Border Background="{Binding HeaderColor}" CornerRadius="6" Padding="8" Margin="0,0,0,9">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="{Binding Text}" Foreground="#B9C5D7" TextWrapping="Wrap" FontSize="11" MaxHeight="70"/>
                                    </StackPanel>

                                </Border>

                                <!-- Коннектор для ручного соединения -->
                                <Ellipse Width="14" Height="14" Fill="#7185F0" Stroke="#DCE3F1" StrokeThickness="1.5"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-8,0"
                                         Cursor="Hand" PointerPressed="OnConnectorPointerPressed"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="3" Width="5" Background="#263244" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

        <!-- Inspector and runtime settings -->
        <Border Grid.Row="1" Grid.Column="4" Background="#111925" BorderBrush="#263244" BorderThickness="1,0,0,0">
            <TabControl Background="#111925">
                <TabItem Header="Inspector">
            <ScrollViewer>
                <StackPanel Spacing="8" Margin="16" DataContext="{Binding SelectedItem, ElementName=ScenesListBox}">
                    <TextBlock Text="СВОЙСТВА УЗЛА" Foreground="#AAB8CC" FontSize="11" FontWeight="Bold" LetterSpacing="1.3"/>
                    <Border Background="#192337" CornerRadius="5" Padding="7,4" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding NodeType}" Foreground="#A8B5FF" FontSize="10" FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Text="Название" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay}" LostFocus="OnSceneNameChanged"/>

                    <TextBlock Text="Имя персонажа" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding CharacterName, Mode=TwoWay}"/>

                    <TextBlock Text="Текст реплики" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>

                    <TextBlock Text="Цвет шапки (#hex)" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding HeaderColor, Mode=TwoWay}"/>

                    <TextBlock Text="Фон сцены (Background)" Foreground="#aaa" FontSize="11"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding Background, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Content="Импорт" Click="OnBrowseAssetClick" Tag="Background" Padding="8,5"/>
                    </Grid>

                    <TextBlock Text="Спрайт персонажа" Foreground="#aaa" FontSize="11"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding CharacterSprite, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Content="Импорт" Click="OnBrowseAssetClick" Tag="CharacterSprite" Padding="8,5"/>
                    </Grid>
                    <TextBlock Text="Анимация персонажа" Foreground="#aaa" FontSize="11"/>
                    <TextBox Text="{Binding CharacterAnimation, Mode=TwoWay}" PlaceholderText="None / FadeIn / SlideLeft" LostFocus="OnAnyFieldChanged"/>

                    <Grid ColumnDefinitions="*, 8, *">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="X персонажа" Foreground="#aaa" FontSize="11"/>
                            <TextBox Text="{Binding CharacterX, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Y персонажа" Foreground="#aaa" FontSize="11"/>
                            <TextBox Text="{Binding CharacterY, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Музыка" Foreground="#aaa" FontSize="11"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding Music, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Content="Импорт" Click="OnBrowseAssetClick" Tag="Music" Padding="8,5"/>
                    </Grid>

                    <Separator Background="#2A2A35" Margin="0,8"/>
                    <!-- НОВОЕ: Настройки для узла "Условие" -->
                    <StackPanel Spacing="8" IsVisible="{Binding NodeType, Converter={StaticResource NodeTypeEquals}, ConverterParameter=Condition}">
                        <Separator Background="#2A2A35" Margin="0,4"/>
                        <TextBlock Text="ЛОГИКА ВЕТВЛЕНИЯ" Foreground="#17a2b8" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>

                        <TextBlock Text="Переменная | Оператор | Значение" Foreground="#aaa" FontSize="10"/>
                        <Grid ColumnDefinitions="*, 40, 60">
                            <TextBox Grid.Column="0" Text="{Binding ConditionVariable, Mode=TwoWay}" PlaceholderText="Имя (Money)" LostFocus="OnAnyFieldChanged"/>
                            <TextBox Grid.Column="1" Text="{Binding ConditionOperator, Mode=TwoWay}" PlaceholderText=">=" Margin="4,0" LostFocus="OnAnyFieldChanged"/>
                            <TextBox Grid.Column="2" Text="{Binding ConditionValue, Mode=TwoWay}" PlaceholderText="100" LostFocus="OnAnyFieldChanged"/>
                        </Grid>

                        <TextBlock Text="Если ИСТИНА (True), идти в:" Foreground="#28a745" FontSize="11"/>
                        <TextBox Text="{Binding TargetSceneIfTrue, Mode=TwoWay}" Foreground="#28a745" LostFocus="OnTargetSceneIfTrueChanged"/>

                        <TextBlock Text="Если ЛОЖЬ (False), идти в:" Foreground="#dc3545" FontSize="11"/>
                        <TextBox Text="{Binding TargetSceneIfFalse, Mode=TwoWay}" Foreground="#dc3545" LostFocus="OnTargetSceneIfFalseChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding NodeType, Converter={StaticResource NodeTypeNotEquals}, ConverterParameter=Choice}">
                        <TextBlock Text="Прямой переход (Имя след. сцены)" Foreground="#aaa" FontSize="11"/>
                        <TextBlock Text="Задаётся протяжкой 🔗 с нода на нод, или вручную" Foreground="#666" FontSize="10" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding TargetSceneName, Mode=TwoWay}" Foreground="#00FF66" LostFocus="OnTargetSceneNameChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding NodeType, Converter={StaticResource NodeTypeEquals}, ConverterParameter=Action}">
                        <Separator Background="#2A2A35" Margin="0,4"/>
                        <TextBlock Text="СИСТЕМНАЯ КОМАНДА" Foreground="#e83e8c" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="PlayMusic: файл.mp3 • StopMusic • Volume: 50 • FadeOut: 2 • FontSize: 24&#x0a;SetVar: HP - 10 • Shake: 1.5 • Flash: #FFFFFF" Foreground="#666" FontSize="10" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding SystemCommand, Mode=TwoWay}" PlaceholderText="Например: PlayMusic: music/theme.ogg" LostFocus="OnAnyFieldChanged"/>
                        <Button Content="Импортировать звуковой эффект" Click="OnBrowseAssetClick" Tag="Sound" HorizontalAlignment="Stretch" Padding="8,5"/>
                        <TextBlock Text="LUA СКРИПТ (необязательно)" Foreground="#e83e8c" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Margin="0,6,0,0"/>
                        <TextBlock Text="Доступны функции движка: get_var, set_var, play_music, play_sound, stop_music, stop_sound, set_volume, fade_music, set_font_size, shake, flash. Файловый ввод-вывод отключён." Foreground="#666" FontSize="10" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding LuaScript, Mode=TwoWay}" PlaceholderText="set_var('HP', get_var('HP') + 1)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" FontFamily="Consolas" LostFocus="OnAnyFieldChanged"/>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding NodeType, Converter={StaticResource NodeTypeEquals}, ConverterParameter=Choice}">
                        <Separator Background="#2A2A35" Margin="0,4"/>
                        <TextBlock Text="ВАРИАНТЫ ВЫБОРА" Foreground="#00FF66" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                        <TextBlock Text="Целевую сцену можно вписать вручную или перетащить 🔗 с нода на нод" Foreground="#666" FontSize="10" TextWrapping="Wrap"/>

                        <ItemsControl ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A24" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                                        <StackPanel Spacing="4">
                                            <TextBox Text="{Binding Text, Mode=TwoWay}" PlaceholderText="Текст варианта" FontSize="12" LostFocus="OnAnyFieldChanged"/>
                                            <TextBox Text="{Binding TargetSceneName, Mode=TwoWay}" PlaceholderText="Имя целевой сцены" FontSize="11" Foreground="#00FF66" LostFocus="OnChoiceTargetSceneNameChanged"/>
                                            <Button Content="✕ Удалить" Click="OnRemoveChoiceClick" Tag="{Binding}" HorizontalAlignment="Right" FontSize="10" Padding="8,3" Background="#dc3545" Foreground="White" Cursor="Hand"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="➕ Добавить вариант" Click="OnAddChoiceClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#007acc" Foreground="White" Cursor="Hand" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
                </TabItem>
                <TabItem Header="Preview">
                    <ScrollViewer>
                        <StackPanel Spacing="15" Margin="16">
                            <TextBlock Text="GAME VIEW CONTROLS" Foreground="#AAB8CC" FontSize="11" FontWeight="Bold" LetterSpacing="1.2"/>
                            <TextBlock Text="Тестируйте текущую историю в отдельном игровом окне." Foreground="#8190A6" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="В игре: F5 — сохранить, F9 — загрузить" Foreground="#8190A6" FontSize="10" TextWrapping="Wrap"/>

                            <Separator Background="#2A2A35" Margin="0,4"/>
                            <TextBlock Text="ОТОБРАЖЕНИЕ" Foreground="#AAB8CC" FontSize="10" FontWeight="Bold" LetterSpacing="1.2"/>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="Размер текста" Foreground="#98A8BE" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="FontSizeTxt" Text="20px" Foreground="#A8B5FF" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="36" Value="20" ValueChanged="OnFontSizeChanged"/>

                            <Separator Background="#2A2A35" Margin="0,4"/>
                            <TextBlock Text="АУДИО" Foreground="#AAB8CC" FontSize="10" FontWeight="Bold" LetterSpacing="1.2"/>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="Громкость музыки" Foreground="#98A8BE" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="VolumeTxt" Text="100%" Foreground="#7AC4CF" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="OnVolumeChanged"/>
                            <Button Content="Плавно остановить музыку" Click="OnFadeOutClick" HorizontalAlignment="Stretch" Background="#202A3A" Foreground="#D4DDF0" Cursor="Hand"/>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="Скорость текста" Foreground="#98A8BE" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TextRevealSpeedTxt" Text="42 знаков/с" Foreground="#7AC4CF" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="TextRevealSpeedSlider" Minimum="0" Maximum="120" Value="42" ValueChanged="OnTextRevealSpeedChanged"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <GridSplitter Grid.Row="2" Grid.ColumnSpan="5" Height="5" Background="#263244" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

        <!-- Project and console dock -->
        <Border Grid.Row="3" Grid.ColumnSpan="5" Background="#111925" BorderBrush="#263244" BorderThickness="0,1,0,1">
            <TabControl Background="#111925">
                <TabItem Header="Project  •  Assets">
                    <Grid RowDefinitions="Auto,*" Margin="10" RowSpacing="8">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="Ресурсы проекта" Foreground="#AAB8CC" FontSize="11" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Открыть папку" Click="OnOpenAssetsFolderClick" Padding="10,5"/>
                            <Button Grid.Column="2" Content="Обновить" Click="OnRefreshAssetsClick" Padding="10,5"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding ProjectAssets}" Background="#0C121B" Foreground="#D4DDF0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Padding="6,4" FontSize="11"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
                <TabItem Header="Console">
                    <Grid RowDefinitions="Auto,*" Margin="10" RowSpacing="8">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Состояние проекта и сообщения runtime" Foreground="#AAB8CC" FontSize="11" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Очистить" Click="OnClearConsoleClick" Padding="10,5"/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding ConsoleMessages}" Background="#0C121B" Foreground="#D4DDF0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Padding="6,3" FontSize="11" FontFamily="Consolas"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="4" Grid.ColumnSpan="5" Background="#0A0F17" Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="CurrentProjectDisplay" Text="Проект не открыт" Foreground="#718198" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="STORY EDITOR  •  READY" Foreground="#63B9A9" FontSize="9" FontWeight="Bold" LetterSpacing="1" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>