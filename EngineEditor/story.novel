[
  {
    "Choices": [],
    "Name": "\u0421\u0446\u0435\u043D\u0430 1: \u0421\u0442\u0430\u0440\u0442",
    "Background": "",
    "Text": "\u0412\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438? \u041E \u0421\u0430\u0442\u043E-\u0441\u0435\u043C\u043F\u0430\u0435 \u0438\u0437 \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E\u0433\u043E. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043E\u043D \u0438\u0441\u0447\u0435\u0437.",
    "Music": "",
    "CharacterName": "\u0425\u0438\u0440\u043E",
    "CharacterSprite": "",
    "CharacterX": 50,
    "CharacterY": 100
  },
  {
    "Choices": [],
    "Name": "\u0421\u0446\u0435\u043D\u0430 2",
    "Background": "",
    "Text": "\u041E\u0447\u0435\u0440\u0435\u0434\u043D\u0430\u044F \u0431\u0430\u0439\u043A\u0430. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0431\u0435\u0436\u0430\u043B \u0438\u0437 \u0434\u043E\u043C\u0430. \u0412\u0435\u0447\u043D\u043E \u0432\u044B, \u043F\u0430\u0440\u043D\u0438, \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0435.",
    "Music": "",
    "CharacterName": "\u041C\u0438\u043A\u0430",
    "CharacterSprite": "",
    "CharacterX": 50,
    "CharacterY": 100
  },
  {
    "Choices": [],
    "Name": "\u0421\u0446\u0435\u043D\u0430 3",
    "Background": "",
    "Text": "\u041D\u0435\u0442, \u0442\u044B \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C! \u041E\u043D \u0445\u043E\u0434\u0438\u043B \u0432 \u0442\u043E\u0442 \u043B\u0435\u0441 \u043D\u0430 \u0441\u0435\u0432\u0435\u0440\u0435, \u00AB\u0422\u0443\u043C\u0430\u043D\u043D\u0443\u044E \u0447\u0430\u0449\u0443\u00BB, \u0437\u0430 \u0441\u0432\u0435\u0442\u043B\u044F\u0447\u043A\u0430\u043C\u0438 \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0439 \u0434\u0435\u0432\u0443\u0448\u043A\u0438. \u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043F\u043E\u0437\u0434\u043D\u043E, \u0432\u0440\u043E\u0434\u0435 \u0431\u044B \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439. \u0410 \u043D\u0430\u0443\u0442\u0440\u043E \u2014 \u043A\u0440\u043E\u0432\u0430\u0442\u044C \u043F\u0443\u0441\u0442\u0430, \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u043D\u0430 \u0441\u0442\u043E\u043B\u0435, \u0432\u0445\u043E\u0434\u043D\u0430\u044F \u0434\u0432\u0435\u0440\u044C \u0437\u0430\u043F\u0435\u0440\u0442\u0430 \u0438\u0437\u043D\u0443\u0442\u0440\u0438. \u0411\u0443\u0434\u0442\u043E \u0438\u0441\u043F\u0430\u0440\u0438\u043B\u0441\u044F.",
    "Music": "",
    "CharacterName": "\u0425\u0438\u0440\u043E",
    "CharacterSprite": "",
    "CharacterX": 50,
    "CharacterY": 100
  },
  {
    "Choices": [],
    "Name": "\u0421\u0446\u0435\u043D\u0430 4",
    "Background": "",
    "Text": "\u0424\u0443, \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u044C. \u042D\u0442\u043E \u0443\u0436\u0435 \u043F\u044F\u0442\u044B\u0439 \u0441\u043B\u0443\u0447\u0430\u0439 \u0437\u0430 \u043C\u0435\u0441\u044F\u0446?",
    "Music": "",
    "CharacterName": "\u041C\u0438\u043A\u0430",
    "CharacterSprite": "",
    "CharacterX": 50,
    "CharacterY": 100
  },
  {
    "Choices": [],
    "Name": "\u0421\u0446\u0435\u043D\u0430 5",
    "Background": "",
    "Text": "\u0421\u0432\u0435\u0442\u043B\u044F\u0447\u043A\u0430\u043C\u0438\u2026 \u041C\u043E\u044F \u0441\u0435\u0441\u0442\u0440\u0430 \u042E\u043D\u0430 \u0432\u0447\u0435\u0440\u0430 \u0442\u043E\u0436\u0435 \u0440\u0438\u0441\u043E\u0432\u0430\u043B\u0430 \u0441\u0432\u0435\u0442\u043B\u044F\u0447\u043A\u043E\u0432. \u0421\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0442\u043E \u043E\u043D\u0438 \u0441\u043D\u044F\u0442\u0441\u044F \u0435\u0439 \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u043E\u0447\u044C \u0438 \u0437\u043E\u0432\u0443\u0442 \u043A\u0443\u0434\u0430-\u0442\u043E.",
    "Music": "",
    "CharacterName": "\u0420\u0435\u043D",
    "CharacterSprite": "",
    "CharacterX": 50,
    "CharacterY": 100
  },
  {
    "Choices": [],
    "Name": "\u0421\u0446\u0435\u043D\u0430 6",
    "Background": "",
    "Text": "\u0414\u0440\u0443\u0437\u044C\u044F \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u044E\u0442. \u0417\u0432\u0435\u043D\u0438\u0442 \u0437\u0432\u043E\u043D\u043E\u043A.",
    "Music": "",
    "CharacterName": "",
    "CharacterSprite": "",
    "CharacterX": 50,
    "CharacterY": 100
  },
  {
    "Choices": [],
    "Name": "\u0421\u0446\u0435\u043D\u0430 7",
    "Background": "",
    "Text": "\u0420\u0435\u043D, \u044D\u0442\u043E \u0441\u0442\u0440\u0451\u043C\u043D\u043E. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043E\u043D\u0438 \u0432\u0441\u0435 \u043F\u0435\u0440\u0435\u0434 \u0438\u0441\u0447\u0435\u0437\u043D\u043E\u0432\u0435\u043D\u0438\u0435\u043C \u0432\u0438\u0434\u0435\u043B\u0438 \u0441\u043D\u044B \u043F\u0440\u043E \u043B\u0435\u0441. \u0418 \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0441. \u041D\u0435 \u043F\u0443\u0441\u043A\u0430\u0439 \u0441\u0435\u0441\u0442\u0440\u0443 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043D\u0430 \u0443\u043B\u0438\u0446\u0443.",
    "Music": "",
    "CharacterName": "\u0425\u0438\u0440\u043E",
    "CharacterSprite": "",
    "CharacterX": 50,
    "CharacterY": 100
  }
